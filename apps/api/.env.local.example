# URL do projeto Supabase
SUPABASE_URL=

# Service role key do Supabase (uso exclusivo no backend, nunca expor no front)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret do Supabase, usado para validar o access_token enviado pelo frontend
SUPABASE_JWT_SECRET=

# Origin do frontend permitida no CORS. Em dev aponta pro apps/web-example
# (ver apps/api/src/middleware/cors.ts) — hoje só há 1 origin permitida por vez;
# quando apps/web-admin/apps/web-public passarem a chamar o apps/api de fato,
# essa checagem precisa aceitar mais de uma origin.
ALLOWED_ORIGIN=http://localhost:3000
